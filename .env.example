# ═══════════════════════════════════════════════════════════════════
# BTC Trading Bot — .env.example
# $87–$200 hesap için optimize edilmiş PROFESYONELconfig.
# Kopyala: cp .env.example .env  →  API key'leri doldur  →  başlat.
# ═══════════════════════════════════════════════════════════════════

# ── Exchange ────────────────────────────────────────────────────────
MEXC_API_KEY=your_api_key_here
MEXC_API_SECRET=your_api_secret_here
PAPER_MODE=true          # live için false yap (önce paper'da test et!)
LEVERAGE=10              # 10x: $200 margin → 0.02 BTC pozisyon
MARGIN_MODE=isolated     # isolated: kayıp pozisyonla sınırlı, hesap güvende
MAKER_ENTRY=true         # post-only limit entry → %0 fee (vs %0.01 taker)

# ── Trading ─────────────────────────────────────────────────────────
SYMBOL=BTC/USDT:USDT
# $200 için sadece BTC. Bakiye büyüyünce çok-coin'e geç (aşağıdaki bloğu aç).
#
# ── ÇOK-COIN GO-LIVE (BTC + ETH + SOL) ─────────────────────────────
# research_strategies_crosscoin.py (ETH/SOL 1h 2023-2025, BTC paramları,
# hiç re-tune YOK) edge'in transfer olduğunu doğruladı:
#   BB    ETH 1.26/2.36  SOL 1.15/1.29   ✅ üçü de
#   ORB   ETH 2.61/2.35  SOL 2.16/2.86   ✅ üçü de
#   Asia  ETH 2.33/1.95  SOL 2.29/1.88   ✅ üçü de
#   S/R   ETH 1.15/1.20  SOL 1.09/1.03   → SOL eşiği geçemedi, hariç
# Çok-coin'e geçmek için şu satırları aç (margin yeterli olunca):
#
#   SYMBOLS=BTC,ETH,SOL,BNB,XRP
#   MAX_POSITIONS=12               # 5 coin × ~2-3 slot
#
# ÖNEMLİ — BB/S-R artık BTC'DEN ÇIKARILDI (one-per-symbol squat bulgusu, 2026-06):
# one-per-symbol guard (coin başına tek pozisyon, netted SL/TP güvenliği için) BTC'de
# tek slot bırakıyor. BB+S/R 48h tutuyor → o tek slotu işgal edip kârlı kısa-tutuşlu
# ORB/FVG'yi blokluyor. Sadık-gating'li BTC simi (2024-05..2026-04): BB/S-R BTC'deyken
# +3.4%/ay (2026 -16%); BTC'den çıkınca +8.0%/ay (HER yıl +, 2026 +24%, maxDD 13→9%).
# BB/S-R silinmedi — ETH/SOL'da kalmaya devam (orada 7 değil 4 sleeve, slot rekabeti az).
BB_SYMBOLS=ETH/USDT:USDT,SOL/USDT:USDT        # BTC çıkarıldı (squat); BNB/XRP zaten geçemedi
SR_BREAKOUT_SYMBOLS=ETH/USDT:USDT             # BTC çıkarıldı (squat); SOL/BNB/XRP geçemedi
#
# Boş bırakılırsa (SYMBOLS, BB_SYMBOLS, SR_BREAKOUT_SYMBOLS) tek-coin geri uyumlu.
#
# Cross-coin test özeti (BTC params, sıfır retuning):
#   Strateji  BTC  ETH  SOL  BNB  XRP
#   BB        ✅   ✅   ✅   ❌   ⚠️   → BB_SYMBOLS=BTC,ETH,SOL
#   ORB       ✅   ✅   ✅   ✅   ✅   → tüm coinler
#   Asia BO   ✅   ✅   ✅   ✅   ✅   → tüm coinler
#   S/R       ✅   ✅   ⚠️   ⚠️   ❌   → SR_BREAKOUT_SYMBOLS=BTC,ETH
PRIMARY_TF=1h
CONFIRM_TF=4h

# ── Strateji Filtreleri ─────────────────────────────────────────────
VOL_FILTER_ENABLED=true

# Funding rate monitor (LIVE-ONLY, işlemi etkilemez, sadece veri toplar)
FUNDING_ENABLED=false
FUNDING_MODE=monitor
FUNDING_EXTREME=0.0005

# Order-flow collector (LIVE-ONLY, işlemi etkilemez, sadece veri toplar)
ORDERFLOW_ENABLED=false
ORDERFLOW_MODE=monitor
ORDERFLOW_WINDOW_MIN=15

# ── 5 Strateji (hepsi backtest'te pozitif, HER YIL) ─────────────────
# BB Mean Reversion: PF 1.24 +%28/yıl (ana strateji, hafta sonu)
# ORB (NY açılışı 14:00 UTC): PF 1.44 +%23/yıl
# Asia BO (Londra 08:00 UTC): PF 2.15 +%14/yıl
# S/R Breakout (güçlü seviye kırılımı): PF 1.72 +%22/yıl
# FVG (Fair Value Gap, ICT price-action): PF 1.37, HER YIL pozitif
ORB_ENABLED=true
# ORB_STOP_ENTRY: fiyat opening-range sınırına DOKUNUR DOKUNMAZ (tick-watcher,
# market emir ~seviyeden) gir — 1h mum kapanışını bekleme. KAPALI (varsayılan):
# edge döneme bağlı. İlk 30 gün stop-touch'ı (PF 1.65 / +12.95$) limit-retrace'in
# (PF 1.41 / +6.43$) önüne geçirdi, ama sonraki dönem tersine döndü: stop-touch
# PF 0.87 / -2.03$  vs  limit-retrace PF 1.42 / +6.54$. Limit-retrace daha sağlam.
# Açmak için ORB_STOP_ENTRY=true (yalnız momentum temizse kazandırır).
ORB_STOP_ENTRY=false
# ASIA_BO_ENABLED: backtest PF 2.15 ama o test intra-candle girişi varsayıyor.
# NOT: Asia BO stop-touch modeli de canlıda başarısız (PF 0.61, false poke'lar WR'yi
# %50→%27 düşürüyor), bu yüzden ORB'un aksine Asia stop-entry'ye AÇILMADI.
# Live'da sinyal 1h kapanışından sonra tetikleniyor → fiyat zaten seviyeyi geçmiş
# → market fill R/R 0.33-0.61, 30 günlük live backtest PF 0.69/0.78 (zarar).
# Yeniden açmak için: ASIA_BO_ENABLED=true + MAKER_ENTRY=true (limit retrace giriş)
ASIA_BO_ENABLED=false
SR_BREAKOUT_ENABLED=true
# S/R çok-coin allowlist (boş = tüm coin'ler). Çok-coin'de SOL'u hariç tut:
# SR_BREAKOUT_SYMBOLS=BTC,ETH
# FVG: EMA200 trend yönünde, boşluk>=0.5×ATR, RR 2.5, limit retest girişi.
# Backtest 2023:1.31 2024:1.53 2025:1.17 2026:1.55 (look-ahead düzeltilmiş, gerçekçi).
FVG_ENABLED=true
FVG_MIN_GAP_ATR=0.5
FVG_RR=2.5
FVG_RISK_PCT=0.02       # FVG risk per trade (serbest bakiyenin %2'si)
# IFVG (Inverse FVG): kitabın ilk DÜŞÜK-korelasyonlu reversal kolu. Varsayılan
# opt-in (KAPALI) ama artık DOĞRULANMIŞ-SAĞLAM: eski gap>=0.5 varyantı 2025'te
# kırılgandı (canlı sürekli koşu PF ~0.99), bu yüzden gap filtresi 0.75×ATR'ye
# yükseltildi. Gerçekçi bekleyen-limit dolum modeliyle (maker giriş, ek kayma yok)
# 2023-2026 tüm geçmişte tekrar doğrulandı: ÜRETİM strateji sınıfı PF 1.35,
# TRAIN 1.34 / TEST 1.45, HER yıl pozitif (2023:1.15 2024:1.70 2025:1.20 2026:1.45).
# AÇIK (canlıya alındı): doğrulanmış-sağlam, kitabın ilk düşük-korelasyonlu
# reversal kolu. Kendi slotunu kullanır (symbol:ifvg) → MAX_POSITIONS'ta yer ister.
IFVG_ENABLED=true
IFVG_MIN_GAP_ATR=0.75
IFVG_RR=2.0
IFVG_RISK_PCT=0.02
# IFVG: BTC + BNB (cross-coin doğrulandı 2026-06, validate_crosscoin.py: BNB
# PF 1.31 TR1.25/TE1.78 her yıl +). ETH/SOL transfer ETMEDİ, XRP sınırda.
IFVG_SYMBOLS=BTC/USDT:USDT,BNB/USDT:USDT
# Squeeze: BTC + SOL (cross-coin doğrulandı: SOL PF 1.40 TR1.42/TE1.23 her yıl +).
# ETH/BNB/XRP geçemedi.
SQUEEZE_SYMBOLS=BTC/USDT:USDT,SOL/USDT:USDT
# Donchian (4h kanal kırılımı swing) — AÇIK (canlıya alındı): ilk yüksek-zaman-
# dilimi / çok-günlük sleeve. Doğrulandı BTC 4h 2023-01..2026-04 (dürüst TRAIN/
# TEST, TAKER maliyet) GERÇEK canlı modeliyle (close-onaylı market giriş =
# force_market, backtest==canlı): kanal=40, RR2.0, SL2.0×ATR, EMA200 trend
# filtresi → PF 1.35 (TRAIN 1.39 / TEST 1.11), HER YIL POZİTİF (2023 1.72 |
# 2024 1.35 | 2025 1.08 | 2026 1.11). Son dönem edge'i IFVG'den ince ama 1-5
# günlük tutuşla 1h intraday sleeve'lerden DEKORELE. Sadece BTC. Kendi slotunu
# kullanır (symbol:donchian) → MAX_POSITIONS'ta yer ister.
DONCHIAN_ENABLED=true
DONCHIAN_CHANNEL=40
DONCHIAN_RR=2.0
DONCHIAN_SL_ATR=2.0
DONCHIAN_EMA_TREND=200
DONCHIAN_BUFFER_ATR=0.0
DONCHIAN_RISK_PCT=0.02
# DONCHIAN_SYMBOLS=BTC/USDT:USDT   # boş → BTC-only (validasyon BTC üzerinde)

# ── Risk (CANLI profil — yüzdelik mod, kademeli büyütme merdiveni) ──
# FIXED_MARGIN_USDT=0 → yüzdelik sizing (canlıda kullanılan mod).
#   notional = min(risk% / SL-mesafesi, POSITION_CAP_FRACTION) × bakiye
#   Cap çoğu trade'de bağlar → gerçek kol POSITION_CAP_FRACTION'dır.
FIXED_MARGIN_USDT=0
MAX_RISK_PCT=0.08        # BB mean-rev + S/R risk % (cap bağladığında çoğunlukla etkisiz)
RISK_SCALE=1.0
#
# ═══ POSITION_CAP_FRACTION — KANIT MERDİVENİ (2026-07 planı) ═══
# Boyut büyütme İŞTAHLA DEĞİL KANITLA yapılır. Basamaklar:
#   1.25  → bugün (ılımlı adım; ölçümü bozmaz, sadece boyutu %25 büyütür)
#   1.50  → ~20-30 temiz canlı işlem sonrası, canlı PF >= 1.2 İSE
#   2.00  → +1 ay daha PF tutuyor + DD kontrollü + bakiye >= ~$250 İSE (tavan)
# Basamak atlamak YASAK: 5 işlemlik veriyle 2.0'a zıplamak = flash-crash'te
# (yılda 1-2 kez olur) bakiyenin %50-70'ini tek olayda riske atmak. Sim (cap
# taraması, one-per-symbol, sadık gating): 1.0→+3.4%/ay | 1.25→~+4.2 | 1.5→+5.4
# | 2.0→+7.3, maxDD %13-15 — ama sim likidasyonu/korelasyonlu çöküşü MODELLEMEZ,
# gerçek kuyruk riski daha büyük. Geri almak: değeri düşür + restart, anında etkir.
POSITION_CAP_FRACTION=1.25

ATR_SL_MULT=3.0
RR_RATIO=1.667           # TP = 5×ATR (SL × 1.667 = 5×ATR/3×ATR)

# Ayrı sermaye modeli: BB (slot=symbol) + ORB (slot=symbol:orb) + Asia (slot=symbol:asia_bo)
# + FVG (slot=symbol:fvg) aynı anda açık olabilir. Her strateji kendi slotunu kullanır.
# S/R breakout BB ile aynı slotu paylaşır (her ikisi de 48h swing); yalnızca BB boşken açılır.
# MAX_POSITIONS=6 → BB/SR + ORB + FVG + Squeeze + IFVG + Donchian paralel
# (IFVG ve Donchian artık AÇIK, ikisi de kendi slotunu ister).
MAX_POSITIONS=6

SNIPER_MIN_GRADE=2   # 0=off, 2=require 2/3 confluence (ATR%+overshoot+VWAP)
# PROFESYONEL günlük zarar limiti: %20.
#   • %35 (eski): 1 günde $30 kayıp → devam eder; yıkıcı olabilir.
#   • %20 (yeni): $87 hesapta ~$17 max kayıp/gün → bileşik büyüme korunur.
# 2 üst üste kayıptan sonra (CONSECUTIVE_LOSS_LIMIT=2) sleeve cooldown da devreye girer.
DAILY_MAX_LOSS_PCT=0.20
MAX_HOLD_CANDLES=48

# Intraday (ORB/Asia BO): ayrı pozisyon slotu, 6 saatte kapanır.
# Her sleeve kendi risk %'si (agresif profil): ORB en güçlü (PF 2.29), sonra Asia.
ORB_RISK_PCT=0.05        # ORB: serbest bakiyenin %5'i risk
ASIA_RISK_PCT=0.03       # Asia BO: serbest bakiyenin %3'i risk
DAY_RISK_PCT=0.05        # yedek (per-sleeve ayarlanmamışsa)
DAY_MAX_HOLD_CANDLES=6
CONFIDENCE_SIZING=false

# ── Trade Yönetimi (Trailing Stop) ──────────────────────────────────
# 1×ATR karda SL entry'ye gelir (bedava trade). Peak - 2×ATR trailing.
TRAILING_STOP_ENABLED=true
BREAKEVEN_ATR_MULT=1.0
TRAILING_ATR_MULT=2.0

# ── Rejim Filtresi (ADX) ────────────────────────────────────────────
# Trending (ADX>28) → BB baskılı (trend karşı trade kaybettirir).
# Ranging  (ADX<20) → ORB/S/R baskılı (yalancı kırılım oranı artar).
REGIME_FILTER_ENABLED=true
ADX_TRENDING_THRESHOLD=28
ADX_RANGING_THRESHOLD=20

# ── Ardışık Kayıp Koruması ──────────────────────────────────────────
# Her strateji sleeve'i bağımsız sayar (BB 2 kayıp, ama ORB 1 galibiyet BB sayacını sıfırlamaz).
# Herhangi bir sleeve limiti aştığında global cooldown başlar.
CONSECUTIVE_LOSS_LIMIT=2
COOLDOWN_MINUTES=240

# ── Korelasyon Koruması ─────────────────────────────────────────────
# BTC/ETH/SOL aynı anda aynı yönde en fazla bu kadar pozisyon açabilir.
# Bir makro haber tüm üçünü aynı anda stop'a uğratabilir → 2-cap ile
# en kötü senaryoda 2 eş zamanlı kayıp, 3 değil.
# 0 = devre dışı (sınır yok).
MAX_CORRELATED_DIRECTION=2

# ── Hafta sonu / Haftaiçi Yönlendirme ───────────────────────────────
# research_bb_weekend_impact.py (3 dönem: 2023/2024/2025-26 tam portföy):
# BB sadece HAFTA SONU açıldığında 3 dönemde de kazanır (PF 1.14/1.26/1.15),
# hafta içi BB negatif edge'tir. Hafta sonuna alınca:
#   - maxDD %42 → ~%25 düşer (en kritik kazanç)
#   - aylık getiri 2. aydan itibaren ~2 katına çıkar
#   - BB artık portföye yük değil, tutarlı katkı
# Bu yüzden default=false (BB yalnız Cmt-Paz). ORB/Asia BO her gün açık kalır.
BB_WEEKDAY_ENABLED=false     # false → BB Pazartesi–Cuma hiç açılmaz (kanıtlanmış optimal)
ORB_WEEKEND_MULT=1.5         # haftasonu ORB risk = ORB_RISK_PCT × 1.5 (maks %8)

# ── Paper Trading ───────────────────────────────────────────────────
PAPER_INITIAL_BALANCE=200.0

# ── Telegram ────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Ntfy (telefon push bildirimi) ────────────────────────────────────
# 1. Telefona ntfy uygulamasını kur (iOS / Android — ntfy.sh)
# 2. NTFY_TOPIC için rastgele bir isim seç (ör. btc-bot-abc123)
# 3. Uygulamada o topic'e subscribe ol.
# Telegram'la paralel çalışır; ikisi birbirinden bağımsızdır.
NTFY_ENABLED=false
NTFY_TOPIC=btc-bot-degistir   # BU İSMİ DEĞİŞTİR — herkese açık topic!
NTFY_SERVER=https://ntfy.sh   # self-host için kendi sunucu URL'in

# ── Web Dashboard (bize-özel canlı panel) ───────────────────────────
# Botla aynı process'te çalışır, trading'e dokunmaz. Telefonun
# tarayıcısından http://<vps-ip>:8080 açılır; ana ekrana kısayol
# ekleyince uygulama gibi durur. Gösterir: canlı bakiye + equity eğrisi
# grafiği, coin başına PnL + aktif sleeve haritası, açık pozisyonlar
# (SL→TP ilerleme barı), aylık P&L barları, strateji kırılımı, son trade'ler.
# GÜVENLİK: VPS IP'si herkese açık → WEB_DASHBOARD_TOKEN ayarla,
# sonra http://<vps-ip>:8080/?token=<token> ile aç.
WEB_DASHBOARD_ENABLED=true   # canlı paneli aç (telefondan takip için)
WEB_DASHBOARD_HOST=0.0.0.0
WEB_DASHBOARD_PORT=8080
WEB_DASHBOARD_TOKEN=        # boş=herkese açık (sadece okunur); bir parola koy

# ── App ─────────────────────────────────────────────────────────────
DB_PATH=./trades.db
LOG_LEVEL=INFO
HEARTBEAT_HOURS=6
